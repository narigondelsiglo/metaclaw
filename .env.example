# ─── LLM Providers (pick at least one) ───────────────────────────────────────

# Option A: z.ai (GLM) — no-cloud alternative, OpenAI-compatible protocol
# Sign up at https://z.ai and use your Code Plan Pro key
ZAI_API_KEY=                     # your z.ai API key
ZAI_BASE_URL=https://api.z.ai/v1 # z.ai OpenAI-compatible endpoint

# Option B: Anthropic (cloud)
ANTHROPIC_API_KEY=               # optional — only if using Anthropic models

# Option C: OpenAI (cloud)
OPENAI_API_KEY=                  # optional — only if using OpenAI models

# ─── Local Inference via Ollama ───────────────────────────────────────────────
# Run models locally — no API key needed
# Default: http://localhost:11434 (override for remote Ollama instances)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama endpoint used for local embeddings (gemma2 or nomic-embed-text)
# Set same as OLLAMA_BASE_URL unless embeddings run on a different host
OLLAMA_EMBED_URL=http://localhost:11434

# ─── Search (pick one) ────────────────────────────────────────────────────────

# Option A: SearXNG — self-hosted, no API key needed
# Run: docker run -d -p 8080:8080 searxng/searxng
SEARXNG_URL=http://localhost:8080

# Option B: Brave Search (cloud)
BRAVE_API_KEY=                   # optional — only if using Brave Search MCP

# ─── Communication Channels (optional) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=              # for Telegram channel integrations
DISCORD_BOT_TOKEN=               # for Discord channel integrations
